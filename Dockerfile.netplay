FROM rust:1.75-slim

# Instalar git para clonar o repositório
RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Clonar o servidor oficial de Netplay do EmulatorJS
RUN git clone https://github.com/EmulatorJS/EmulatorJS-Netplay.git .

# Compilar o servidor (pode demorar alguns minutos no primeiro build)
RUN cargo build --release

# O servidor roda na porta 3000 por padrão
EXPOSE 3000

# Executar o binário compilado
CMD ["./target/release/emulatorjs-netplay"]
