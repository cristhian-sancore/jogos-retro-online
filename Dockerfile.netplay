FROM rust:slim

# Instalar git e dependências de compilação C++ / OpenSSL (necessárias para compilar os pacotes do Rust)
RUN apt-get update && apt-get install -y git build-essential pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Clonar o servidor oficial de Netplay do EmulatorJS
RUN git clone https://github.com/EmulatorJS/EmulatorJS-Netplay.git .

# Compilar o servidor
RUN cargo build --release

# O servidor em Rust do EmulatorJS roda na porta 4000 por padrão
EXPOSE 4000

# Executar o binário compilado
CMD ["./target/release/emulatorjs-netplay"]
